# Optional: docker compose up --build works without copying this file.
FRONTEND_PORT=5173
BACKEND_PORT=8000

# Browser-visible API URL; empty uses http://127.0.0.1:<BACKEND_PORT>.
# VITE_ values are public. Do not put secrets here.
VITE_API_BASE_URL=

# Max PDF upload size in bytes; empty uses 52428800 (50 MiB).
MAX_UPLOAD_SIZE_BYTES=

# Comma-separated origins allowed to call the backend from a browser.
# Empty uses http://127.0.0.1:<FRONTEND_PORT>,http://localhost:<FRONTEND_PORT>.
CORS_ALLOWED_ORIGINS=
